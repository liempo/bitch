{
  "name": "bitch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check:generated": "npm run check:generated --workspaces --if-present",
    "fixtures:validate": "npm run fixtures:validate --workspace @bitch/protocol",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run typecheck && npm run lint && npm test && npm run check:generated && npm run fixtures:validate"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.10.13",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0"
  }
}
