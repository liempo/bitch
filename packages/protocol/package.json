{
  "name": "@bitch/protocol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures",
    "generated"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:generated": "tsx src/generation/cli.ts --check",
    "fixtures:generate": "tsx src/generation/cli.ts",
    "fixtures:validate": "tsx src/validation/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "canonicalize": "3.0.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "tsx": "4.21.0",
    "vitest": "4.1.10"
  }
}
