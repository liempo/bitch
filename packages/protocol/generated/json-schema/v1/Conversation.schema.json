{
  "$id": "https://bitch.invalid/schema/v1/Conversation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activityAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "completedAt": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "completedSinceViewed": {
      "type": "boolean"
    },
    "conversationId": {
      "minLength": 1,
      "type": "string"
    },
    "createdAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "cwd": {
      "pattern": "^/",
      "type": "string"
    },
    "gatewayId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "readOnly": {
      "type": "boolean"
    },
    "status": {
      "anyOf": [
        {
          "const": "idle",
          "type": "string"
        },
        {
          "const": "working",
          "type": "string"
        },
        {
          "const": "needsInput",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "stopped",
          "type": "string"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trashedAt": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "trashReason": {
      "anyOf": [
        {
          "anyOf": [
            {
              "const": "individual",
              "type": "string"
            },
            {
              "const": "workspace",
              "type": "string"
            },
            {
              "const": "workspaceMissing",
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "viewedAt": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "conversationId",
    "title",
    "cwd",
    "createdAt",
    "activityAt",
    "viewedAt",
    "completedAt",
    "status",
    "completedSinceViewed",
    "trashedAt",
    "trashReason",
    "readOnly"
  ],
  "title": "Conversation",
  "type": "object"
}
