{
  "$id": "https://bitch.invalid/schema/v1/SessionChangeResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": true,
      "properties": {
        "cancelled": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "cancelled"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "cancelled": {
          "const": false,
          "type": "boolean"
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "conversationId": {
                  "minLength": 1,
                  "type": "string"
                },
                "gatewayId": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                }
              },
              "required": [
                "gatewayId",
                "conversationId"
              ],
              "type": "object"
            },
            {
              "additionalProperties": true,
              "properties": {
                "conversationId": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "conversationId"
              ],
              "type": "object"
            }
          ]
        }
      },
      "required": [
        "cancelled",
        "target"
      ],
      "type": "object"
    }
  ],
  "title": "SessionChangeResult"
}
