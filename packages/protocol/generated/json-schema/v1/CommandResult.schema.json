          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "output",
        "cancelled",
        "truncated"
      ],
      "type": "object"
    },
    {
      "anyOf": [
        {
          "additionalProperties": true,
          "properties": {
            "artifactId": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "byteCount": {
              "minimum": 0,
              "type": "integer"
            },
            "conversationId": {
              "minLength": 1,
              "type": "string"
            },
            "createdAt": {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            "downloadUrl": {
              "pattern": "^/v1/artifacts/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            "fileName": {
              "minLength": 1,
              "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000]+$",
              "type": "string"
            },
            "gatewayId": {
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
