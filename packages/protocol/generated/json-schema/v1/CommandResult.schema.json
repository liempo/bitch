                  "additionalProperties": true,
                  "properties": {
                    "conversationId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "gatewayId": {
                      "format": "uuid",
                      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "gatewayId",
                    "conversationId"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": true,
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "gatewayId"
                        ]
                      }
                    ]
                  },
                  "properties": {
                    "conversationId": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "conversationId"
                  ],
                  "type": "object"
                }
              ]
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "cancelled",
            "target"
          ],
          "type": "object"
        }
      ]
    },
    {
      "type": "null"
    }
