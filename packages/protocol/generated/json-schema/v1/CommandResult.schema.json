                  "required": [
                    "conversationId"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "cancelled",
            "target"
          ],
          "type": "object"
        }
      ]
    },
    {
      "anyOf": [
        {
          "additionalProperties": true,
          "not": {
            "anyOf": [
              {
