{
  "$id": "https://bitch.invalid/schema/v1/CommandResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": true,
      "properties": {
        "contextWindow": {
          "minimum": 1,
          "type": "integer"
        },
        "input": {
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "maxTokens": {
          "minimum": 1,
          "type": "integer"
        },
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "reasoning": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "modelId",
        "name",
        "reasoning",
        "input",
        "contextWindow",
        "maxTokens"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "isScoped": {
          "type": "boolean"
        },
        "model": {
          "additionalProperties": true,
          "properties": {
            "contextWindow": {
              "minimum": 1,
              "type": "integer"
            },
            "input": {
              "items": {
                "enum": [
                  "text",
                  "image"
                ]
              },
              "type": "array",
              "uniqueItems": true
            },
            "maxTokens": {
              "minimum": 1,
              "type": "integer"
            },
            "modelId": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "type": "string"
            },
            "reasoning": {
              "type": "boolean"
            }
          },
          "required": [
            "provider",
            "modelId",
            "name",
            "reasoning",
            "input",
            "contextWindow",
            "maxTokens"
          ],
          "type": "object"
        },
        "thinkingLevel": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "model",
        "thinkingLevel",
        "isScoped"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "level": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "properties": {
        "details": {
          "$defs": {
            "JsonValue": {
              "$id": "JsonValue",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "items": {
                    "$ref": "JsonValue"
                  },
                  "type": "array"
                },
                {
                  "patternProperties": {
                    "^.*$": {
                      "$ref": "JsonValue"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          },
          "$ref": "JsonValue"
        },
        "estimatedTokensAfter": {
          "minimum": 0,
          "type": "number"
        },
        "firstKeptEntryId": {
          "minLength": 1,
          "type": "string"
