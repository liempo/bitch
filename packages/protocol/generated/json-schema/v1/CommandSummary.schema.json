{
  "$id": "https://bitch.invalid/schema/v1/CommandSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "description": {
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "enum": [
        "extension",
        "prompt",
        "skill"
      ]
    },
    "sourceInfo": {
      "additionalProperties": true,
      "properties": {
        "origin": {
          "enum": [
            "package",
            "top-level"
          ]
        },
        "scope": {
          "enum": [
            "user",
            "project",
            "temporary"
          ]
        },
        "source": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source",
        "scope",
        "origin"
      ],
      "type": "object"
    }
  },
  "required": [
    "name",
    "source",
    "sourceInfo"
  ],
  "title": "CommandSummary",
  "type": "object"
}
