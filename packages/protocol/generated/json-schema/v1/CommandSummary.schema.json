{
  "$id": "https://bitch.invalid/schema/v1/CommandSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "description": {
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "const": "extension",
          "type": "string"
        },
        {
          "const": "prompt",
          "type": "string"
        },
        {
          "const": "skill",
          "type": "string"
        }
      ]
    },
    "sourceInfo": {
      "additionalProperties": true,
      "properties": {
        "origin": {
          "anyOf": [
            {
              "const": "package",
              "type": "string"
            },
            {
              "const": "top-level",
              "type": "string"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "const": "user",
              "type": "string"
            },
            {
              "const": "project",
              "type": "string"
            },
            {
              "const": "temporary",
              "type": "string"
            }
          ]
        },
        "source": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source",
        "scope",
        "origin"
      ],
      "type": "object"
    }
  },
  "required": [
    "name",
    "source",
    "sourceInfo"
  ],
  "title": "CommandSummary",
  "type": "object"
}
