{
  "$id": "https://bitch.invalid/schema/v1/ToolCall.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "arguments": {
      "patternProperties": {
        "^.*$": {
          "$defs": {
            "JsonValue": {
              "$id": "JsonValue",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "items": {
                    "$ref": "JsonValue"
                  },
                  "type": "array"
                },
                {
                  "patternProperties": {
                    "^.*$": {
                      "$ref": "JsonValue"
                    }
                  },
                  "type": "object"
                }
              ]
            }
          },
          "$ref": "JsonValue"
        }
      },
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "thoughtSignature": {
      "type": "string"
    },
    "type": {
      "const": "toolCall",
      "type": "string"
    }
  },
  "required": [
    "type",
    "id",
    "name",
    "arguments"
  ],
  "title": "ToolCall",
  "type": "object"
}
