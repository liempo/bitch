{
  "$id": "https://bitch.invalid/schema/v1/ConversationState.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "activeCommandIds": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "type": "string"
      },
      "type": "array"
    },
    "autoCompactionEnabled": {
      "type": "boolean"
    },
    "autoRetryEnabled": {
      "type": "boolean"
    },
    "conversation": {
      "additionalProperties": true,
      "properties": {
        "activityAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "completedAt": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedSinceViewed": {
          "type": "boolean"
        },
        "conversationId": {
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "cwd": {
          "pattern": "^/",
          "type": "string"
        },
        "gatewayId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "status": {
          "anyOf": [
            {
              "const": "idle",
              "type": "string"
            },
            {
              "const": "working",
              "type": "string"
            },
            {
              "const": "needsInput",
              "type": "string"
            },
            {
              "const": "failed",
              "type": "string"
            },
            {
              "const": "stopped",
              "type": "string"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trashedAt": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trashReason": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "individual",
                  "type": "string"
                },
                {
                  "const": "workspace",
                  "type": "string"
                },
                {
                  "const": "workspaceMissing",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "viewedAt": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "conversationId",
        "title",
        "cwd",
        "createdAt",
        "activityAt",
        "viewedAt",
        "completedAt",
        "status",
        "completedSinceViewed",
        "trashedAt",
        "trashReason",
        "readOnly"
      ],
      "type": "object"
    },
    "followUpMode": {
      "anyOf": [
        {
          "const": "all",
          "type": "string"
        },
        {
          "const": "one-at-a-time",
          "type": "string"
        }
      ]
    },
    "messageCount": {
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "anyOf": [
        {
          "additionalProperties": true,
          "properties": {
            "contextWindow": {
              "minimum": 1,
              "type": "integer"
            },
            "input": {
              "items": {
                "anyOf": [
                  {
                    "const": "text",
                    "type": "string"
                  },
                  {
                    "const": "image",
                    "type": "string"
                  }
                ]
              },
              "type": "array",
              "uniqueItems": true
            },
            "maxTokens": {
              "minimum": 1,
              "type": "integer"
            },
            "modelId": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "minLength": 1,
              "type": "string"
            },
            "reasoning": {
              "type": "boolean"
            }
          },
          "required": [
            "provider",
            "modelId",
            "name",
            "reasoning",
            "input",
            "contextWindow",
            "maxTokens"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "pendingMessageCount": {
      "minimum": 0,
      "type": "integer"
    },
    "steeringMode": {
      "anyOf": [
        {
          "const": "all",
          "type": "string"
        },
        {
          "const": "one-at-a-time",
          "type": "string"
        }
      ]
    },
    "thinkingLevel": {
      "anyOf": [
        {
          "const": "off",
          "type": "string"
        },
        {
          "const": "minimal",
          "type": "string"
        },
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        },
        {
          "const": "xhigh",
          "type": "string"
        },
        {
          "const": "max",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "conversation",
    "model",
    "thinkingLevel",
    "steeringMode",
    "followUpMode",
    "autoCompactionEnabled",
    "autoRetryEnabled",
    "messageCount",
    "pendingMessageCount",
    "activeCommandIds"
  ],
  "title": "ConversationState",
  "type": "object"
}
