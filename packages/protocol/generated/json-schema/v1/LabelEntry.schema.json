{
  "$id": "https://bitch.invalid/schema/v1/LabelEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "parentId": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "targetId": {
      "minLength": 1,
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "type": {
      "const": "label",
      "type": "string"
    }
  },
  "required": [
    "id",
    "parentId",
    "timestamp",
    "type",
    "targetId"
  ],
  "title": "LabelEntry",
  "type": "object"
}
