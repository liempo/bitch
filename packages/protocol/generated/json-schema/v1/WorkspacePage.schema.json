{
  "$id": "https://bitch.invalid/schema/v1/WorkspacePage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "items": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "activeConversationCount": {
            "minimum": 0,
            "type": "integer"
          },
          "activityAt": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "type": "string"
          },
          "createdAt": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
            "type": "string"
          },
          "directoryName": {
            "minLength": 1,
            "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000]+$",
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "gatewayId": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          },
          "gitState": {
            "enum": [
              "none",
              "initialized",
              "cloned"
            ]
          },
          "isDefault": {
            "type": "boolean"
          },
          "state": {
            "enum": [
              "active",
              "trashed",
              "missing"
            ]
          },
          "totalConversationCount": {
            "minimum": 0,
            "type": "integer"
          },
          "trashedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "workspaceId": {
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "workspaceId",
          "gatewayId",
          "directoryName",
          "displayName",
          "isDefault",
          "gitState",
          "createdAt",
          "activityAt",
          "trashedAt",
          "state",
          "activeConversationCount",
          "totalConversationCount"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nextCursor": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "items",
    "nextCursor",
    "revision"
  ],
  "title": "WorkspacePage",
  "type": "object"
}
