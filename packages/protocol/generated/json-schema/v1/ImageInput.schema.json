{
  "$id": "https://bitch.invalid/schema/v1/ImageInput.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "fileName": {
      "pattern": "^[^/\\\\]+$",
      "type": "string"
    },
    "mimeType": {
      "anyOf": [
        {
          "const": "image/png",
          "type": "string"
        },
        {
          "const": "image/jpeg",
          "type": "string"
        },
        {
          "const": "image/webp",
          "type": "string"
        },
        {
          "const": "image/gif",
          "type": "string"
        }
      ]
    },
    "type": {
      "const": "image",
      "type": "string"
    }
  },
  "required": [
    "type",
    "data",
    "mimeType"
  ],
  "title": "ImageInput",
  "type": "object"
}
