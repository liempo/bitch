{
  "$id": "https://bitch.invalid/schema/v1/ImageInput.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "type": "string"
    },
    "fileName": {
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000]+$",
      "type": "string"
    },
    "mimeType": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/webp",
        "image/gif"
      ]
    },
    "type": {
      "const": "image",
      "type": "string"
    }
  },
  "required": [
    "type",
    "data",
    "mimeType"
  ],
  "title": "ImageInput",
  "type": "object"
}
