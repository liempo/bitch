{
  "$id": "https://bitch.invalid/schema/v1/ConversationSummary.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": true,
      "properties": {
        "activityAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "completedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedSinceViewed": {
          "type": "boolean"
        },
        "conversationId": {
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "gatewayId": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "idle",
            "working",
            "needsInput",
            "failed",
            "stopped"
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trashReason": {
          "anyOf": [
            {
              "enum": [
                "individual",
                "workspace",
                "workspaceMissing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "trashedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceId": {
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "type": "string"
        }
      },
      "required": [
        "conversationId",
        "title",
        "createdAt",
        "activityAt",
        "viewedAt",
        "completedAt",
        "status",
        "completedSinceViewed",
        "trashedAt",
        "trashReason",
        "readOnly",
        "gatewayId",
        "workspaceId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": true,
      "not": {
        "anyOf": [
          {
            "required": [
              "gatewayId"
            ]
          },
          {
            "required": [
              "workspaceId"
            ]
          }
        ]
      },
      "properties": {
        "activityAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "completedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedSinceViewed": {
          "type": "boolean"
        },
        "conversationId": {
          "minLength": 1,
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "readOnly": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "idle",
            "working",
            "needsInput",
            "failed",
            "stopped"
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trashReason": {
          "anyOf": [
            {
              "enum": [
                "individual",
                "workspace",
                "workspaceMissing"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "trashedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "viewedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "conversationId",
        "title",
        "createdAt",
        "activityAt",
        "viewedAt",
        "completedAt",
        "status",
        "completedSinceViewed",
        "trashedAt",
        "trashReason",
        "readOnly"
      ],
      "type": "object"
    }
  ],
  "title": "ConversationSummary"
}
