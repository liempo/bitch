{
  "$id": "https://bitch.invalid/schema/v1/JsonObject.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patternProperties": {
    "^.*$": {
      "$defs": {
        "JsonValue": {
          "$id": "JsonValue",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "JsonValue"
              },
              "type": "array"
            },
            {
              "patternProperties": {
                "^.*$": {
                  "$ref": "JsonValue"
                }
              },
              "type": "object"
            }
          ]
        }
      },
      "$ref": "JsonValue"
    }
  },
  "title": "JsonObject",
  "type": "object"
}
