{
  "$id": "https://bitch.invalid/schema/v1/CreateConversationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commandId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "images": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "type": "string"
          },
          "fileName": {
            "pattern": "^[^/\\\\]+$",
            "type": "string"
          },
          "mimeType": {
            "anyOf": [
              {
                "const": "image/png",
                "type": "string"
              },
              {
                "const": "image/jpeg",
                "type": "string"
              },
              {
                "const": "image/webp",
                "type": "string"
              },
              {
                "const": "image/gif",
                "type": "string"
              }
            ]
          },
          "type": {
            "const": "image",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data",
          "mimeType"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId"
      ],
      "type": "object"
    },
    "thinkingLevel": {
      "anyOf": [
        {
          "const": "off",
          "type": "string"
        },
        {
          "const": "minimal",
          "type": "string"
        },
        {
          "const": "low",
          "type": "string"
        },
        {
          "const": "medium",
          "type": "string"
        },
        {
          "const": "high",
          "type": "string"
        },
        {
          "const": "xhigh",
          "type": "string"
        },
        {
          "const": "max",
          "type": "string"
        }
      ]
    },
    "workspaceId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "commandId",
    "message"
  ],
  "title": "CreateConversationRequest",
  "type": "object"
}
