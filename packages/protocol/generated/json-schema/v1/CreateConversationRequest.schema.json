{
  "$id": "https://bitch.invalid/schema/v1/CreateConversationRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commandId": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "images": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
            "type": "string"
          },
          "fileName": {
            "minLength": 1,
            "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000]+$",
            "type": "string"
          },
          "mimeType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/gif"
            ]
          },
          "type": {
            "const": "image",
            "type": "string"
          }
        },
        "required": [
          "type",
          "data",
          "mimeType"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "message": {
      "type": "string"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "provider",
        "modelId"
      ],
      "type": "object"
    },
    "thinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "workspaceId": {
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "required": [
    "commandId",
    "message"
  ],
  "title": "CreateConversationRequest",
  "type": "object"
}
