{
  "$id": "https://bitch.invalid/schema/v1/ModelCycleResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "isScoped": {
      "type": "boolean"
    },
    "model": {
      "additionalProperties": true,
      "properties": {
        "contextWindow": {
          "minimum": 1,
          "type": "integer"
        },
        "input": {
          "items": {
            "enum": [
              "text",
              "image"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "maxTokens": {
          "minimum": 1,
          "type": "integer"
        },
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "reasoning": {
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "modelId",
        "name",
        "reasoning",
        "input",
        "contextWindow",
        "maxTokens"
      ],
      "type": "object"
    },
    "thinkingLevel": {
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    }
  },
  "required": [
    "model",
    "thinkingLevel",
    "isScoped"
  ],
  "title": "ModelCycleResult",
  "type": "object"
}
