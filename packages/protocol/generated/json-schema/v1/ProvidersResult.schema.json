{
  "$id": "https://bitch.invalid/schema/v1/ProvidersResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "providers": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "authentication": {
            "items": {
              "enum": [
                "api_key",
                "oauth"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "providerId": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "authenticated",
              "unauthenticated",
              "expired"
            ]
          }
        },
        "required": [
          "providerId",
          "name",
          "authentication",
          "status"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "providers"
  ],
  "title": "ProvidersResult",
  "type": "object"
}
